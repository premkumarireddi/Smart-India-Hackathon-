# Python
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.venv/
venv/

# Large / regenerable data & model artifacts
backend/data/raw/
backend/models/train_stdout.log

# Per-dataset resize cache (ml/dataset.py) — regenerable, can appear inside
# any dataset root including the committed synthetic one
.cache128/

# Keep the small synthetic dataset AND the demo checkpoint committed — the
# whole point is `git clone` + `uvicorn app.main:app` works immediately with
# no retraining step required. Only ignore what a user downloads themselves
# via ml/download_data.py into data/raw/ (that's 100MB-several-GB, real
# Kaggle data, and shouldn't live in git).

# Node (if the frontend ever grows a build step)
node_modules/
dist/

# OS / editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/

# Logs
*.log
